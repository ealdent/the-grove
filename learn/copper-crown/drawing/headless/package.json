{
  "name": "dimensional-drawing-motion-headless",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Render dimensional-drawing motion scenes to MP4 with Playwright + ffmpeg.",
  "scripts": {
    "postinstall": "playwright install chromium",
    "render": "node render.mjs --scene ../copper-crown-drawing.js --css ../copper-crown-drawing.css --duration 11 --fps 30 --width 1920 --height 1080 --crf 18 --out ../copper-crown-drawing.mp4"
  },
  "dependencies": {
    "playwright": "^1.47.0"
  },
  "license": "MIT"
}
